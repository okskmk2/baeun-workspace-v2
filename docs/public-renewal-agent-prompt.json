  "pricing_model": {
    "type": "metered_monthly_slots",
    "forbidden": [
      "Free/Team/Business/Enterprise 비교표",
      "추천 플랜 배지",
      "연간 구독 티어",
      "플랜별로 위키·칸반·채널·데이터를 잠그는 카피"
    ],
    "meters": [
      {
        "id": "workspace",
        "name": "워크스페이스 슬롯",
        "unit": "조직 1개",
        "period": "month",
        "price": "USE_STORE_MASTER",
        "unlocks": ["프로젝트 허브", "게시판", "랭킹", "워크스페이스 설정"],
        "includes": "워크스페이스당 기본 스토리지 5GB"
      },
      {
        "id": "project",
        "name": "프로젝트 슬롯",
        "unit": "프로젝트 1개",
        "period": "month",
        "price": "USE_STORE_MASTER",
        "unlocks": ["위키", "칸반", "채널", "데이터"]
      },
      {
        "id": "workspace_member",
        "name": "워크스페이스 멤버 슬롯",
        "unit": "좌석 1명",
        "period": "month",
        "price": "USE_STORE_MASTER",
        "unlocks": ["해당 워크스페이스 초대·접속"],
        "note": "계정 전역 좌석이 아니라 워크스페이스 좌석"
      },
      {
        "id": "storage",
        "name": "스토리지 슬롯",
        "unit": "초과 1GB",
        "period": "month",
        "price_usd": 0.1,
        "scope": "per_workspace",
        "base_gb_per_workspace": 5,
        "formula": "sum(max(0, used_gb_i - 5)) * 0.10",
        "no_pool_across_workspaces": true
      }
    ],
    "monthly_formula": "workspace_slots * workspace_unit_price + project_slots * project_unit_price + member_slots * member_unit_price + extra_gb * 0.10",
    "storage_examples": [
      { "workspaces": [{ "used_gb": 3.2 }], "billable_gb": 0, "storage_usd": 0 },
      { "workspaces": [{ "used_gb": 7.4 }], "billable_gb": 2.4, "storage_usd": 0.24, "rounding_note": "소수 GB 그대로 곱한다. 구현에서 올림이 이미 있으면 그 정책을 화면에 명시" }
    ],
    "unit_price_source": {
      "instruction": "워크스페이스·프로젝트·멤버 단가는 하드코딩하지 말고 기존 스토어/라이선스 카탈로그 값을 재사용한다. 값이 없으면 플레이스홀더와 '스토어에서 확인' CTA만 두고 가짜 달러를 만들지 말 것. 스토리지 $0.10/GB만 확정 숫자다."
    },
    "purchase_flow": {
      "understand": "/pricing",
      "buy": ["/store", "/store/cart"],
      "entitlements": "/settings/plan",
      "invoice": "/settings/billing",
      "usage": "/workspace/:id/settings/license"
    },
    "copy_rules": {
      "say": [
        "묶음 요금제 없이 자리만큼 월 결제",
        "워크스페이스마다 기본 5GB",
        "넘는 용량만 1GB당 $0.10",
        "도구 종류는 같고 자리가 있어야 공간이 열린다"
      ],
      "never_say": [
        "무료 플랜 / 팀 플랜 / 비즈니스 플랜",
        "공용 스토리지 풀",
        "로그인하면 바로 칸반",
        "요금제 페이지와 가격 페이지가 다릅니다"
      ]
    }
  },

