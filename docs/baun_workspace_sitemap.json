{
  "product": "바은 워크스페이스",
  "version": "1.0.0",
  "description": "슬랙 + 지라 + 컨플루언스 + 데이터 관리 + AI 에이전트 통합 협업 플랫폼",
  "root": {
    "path": "/",
    "description": "워크스페이스 루트 — 로그인 전 랜딩 또는 워크스페이스 선택 화면",
    "actions": [
      { "id": "login", "method": "POST", "endpoint": "/auth/login", "description": "이메일·SSO 로그인" },
      { "id": "signup", "method": "POST", "endpoint": "/auth/signup", "description": "신규 워크스페이스 생성 및 계정 등록" },
      { "id": "select_workspace", "method": "GET", "endpoint": "/workspaces", "description": "내가 속한 워크스페이스 목록 조회 및 선택" }
    ],
    "links": [],
    "children": [
      {
        "path": "/:workspaceId",
        "pathparam": {
          "workspaceId": "워크스페이스 고유 식별자 (slug 또는 UUID)"
        },
        "description": "워크스페이스 홈 — 최근 활동, 즐겨찾기, 공지, AI 요약 대시보드",
        "actions": [
          { "id": "get_home_feed", "method": "GET", "endpoint": "/:workspaceId/home", "description": "최근 활동 피드 및 AI 일간 요약 조회" },
          { "id": "get_pinned", "method": "GET", "endpoint": "/:workspaceId/pinned", "description": "즐겨찾기·고정 항목 조회" },
          { "id": "update_workspace_settings", "method": "PATCH", "endpoint": "/:workspaceId/settings", "description": "워크스페이스 이름·아이콘·도메인 수정 (관리자)" }
        ],
        "links": ["/:workspaceId/wiki", "/:workspaceId/kanban", "/:workspaceId/channel", "/:workspaceId/data"],
        "children": [

          {
            "path": "/:workspaceId/wiki",
            "pathparam": {
              "workspaceId": "워크스페이스 식별자"
            },
            "description": "위키 — 문서·계약서·지식베이스 관리. MS Word·노션·구글 독스 대체",
            "actions": [
              { "id": "list_wikis", "method": "GET", "endpoint": "/:workspaceId/wiki", "description": "위키 문서 목록 조회 (트리 구조)" },
              { "id": "create_wiki", "method": "POST", "endpoint": "/:workspaceId/wiki", "description": "새 위키 문서 생성" },
              { "id": "search_wiki", "method": "GET", "endpoint": "/:workspaceId/wiki/search?q=", "description": "위키 전문 검색" }
            ],
            "links": ["/:workspaceId/wiki/:docId"],
            "children": [
              {
                "path": "/:workspaceId/wiki/:docId",
                "pathparam": {
                  "workspaceId": "워크스페이스 식별자",
                  "docId": "문서 고유 ID"
                },
                "description": "위키 문서 상세 — 블록 기반 에디터, 실시간 공동편집, 버전 관리",
                "actions": [
                  { "id": "get_doc", "method": "GET", "endpoint": "/:workspaceId/wiki/:docId", "description": "문서 내용 조회" },
                  { "id": "update_doc", "method": "PATCH", "endpoint": "/:workspaceId/wiki/:docId", "description": "문서 블록 편집 (실시간 CRDT 동기화)" },
                  { "id": "delete_doc", "method": "DELETE", "endpoint": "/:workspaceId/wiki/:docId", "description": "문서 삭제 (휴지통 이동)" },
                  { "id": "publish_doc", "method": "POST", "endpoint": "/:workspaceId/wiki/:docId/publish", "description": "외부 공개 링크 발행" },
                  { "id": "export_doc", "method": "GET", "endpoint": "/:workspaceId/wiki/:docId/export?format=pdf|docx|md", "description": "PDF·DOCX·마크다운으로 내보내기" },
                  { "id": "list_versions", "method": "GET", "endpoint": "/:workspaceId/wiki/:docId/versions", "description": "버전 히스토리 목록 조회" },
                  { "id": "restore_version", "method": "POST", "endpoint": "/:workspaceId/wiki/:docId/versions/:versionId/restore", "description": "특정 버전으로 복원" },
                  { "id": "add_comment", "method": "POST", "endpoint": "/:workspaceId/wiki/:docId/comments", "description": "문서 인라인 댓글 추가" },
                  { "id": "convert_to_task", "method": "POST", "endpoint": "/:workspaceId/wiki/:docId/blocks/:blockId/to-task", "description": "문서 블록을 칸반 태스크로 전환" },
                  { "id": "ai_summarize", "method": "POST", "endpoint": "/:workspaceId/wiki/:docId/ai/summarize", "description": "AI 문서 요약 생성" },
                  { "id": "ai_action_items", "method": "POST", "endpoint": "/:workspaceId/wiki/:docId/ai/extract-actions", "description": "AI 액션 아이템 추출 → 칸반 자동 생성" },
                  { "id": "manage_permissions", "method": "PATCH", "endpoint": "/:workspaceId/wiki/:docId/permissions", "description": "문서 열람·편집 권한 관리" }
                ],
                "links": ["/:workspaceId/kanban/:boardId", "/:workspaceId/channel/:channelId"],
                "children": []
              }
            ]
          },

          {
            "path": "/:workspaceId/kanban",
            "pathparam": {
              "workspaceId": "워크스페이스 식별자"
            },
            "description": "칸반 — 프로젝트·스프린트·태스크 관리. 지라 대체",
            "actions": [
              { "id": "list_boards", "method": "GET", "endpoint": "/:workspaceId/kanban", "description": "보드 목록 조회" },
              { "id": "create_board", "method": "POST", "endpoint": "/:workspaceId/kanban", "description": "새 프로젝트 보드 생성" }
            ],
            "links": ["/:workspaceId/kanban/:boardId"],
            "children": [
              {
                "path": "/:workspaceId/kanban/:boardId",
                "pathparam": {
                  "workspaceId": "워크스페이스 식별자",
                  "boardId": "보드 고유 ID"
                },
                "description": "칸반 보드 — 컬럼·태스크 관리, 스프린트, 로드맵 뷰 전환",
                "actions": [
                  { "id": "get_board", "method": "GET", "endpoint": "/:workspaceId/kanban/:boardId", "description": "보드 전체 조회 (컬럼·태스크 포함)" },
                  { "id": "create_column", "method": "POST", "endpoint": "/:workspaceId/kanban/:boardId/columns", "description": "새 컬럼(상태) 추가" },
                  { "id": "reorder_columns", "method": "PATCH", "endpoint": "/:workspaceId/kanban/:boardId/columns/reorder", "description": "컬럼 순서 변경" },
                  { "id": "create_task", "method": "POST", "endpoint": "/:workspaceId/kanban/:boardId/tasks", "description": "태스크 생성" },
                  { "id": "bulk_create_tasks", "method": "POST", "endpoint": "/:workspaceId/kanban/:boardId/tasks/bulk", "description": "AI 추출 액션 아이템 일괄 태스크 생성" },
                  { "id": "switch_view", "method": "GET", "endpoint": "/:workspaceId/kanban/:boardId?view=kanban|list|timeline|calendar", "description": "뷰 전환 — 칸반·목록·타임라인·캘린더" },
                  { "id": "create_sprint", "method": "POST", "endpoint": "/:workspaceId/kanban/:boardId/sprints", "description": "스프린트 생성" },
                  { "id": "start_sprint", "method": "POST", "endpoint": "/:workspaceId/kanban/:boardId/sprints/:sprintId/start", "description": "스프린트 시작" },
                  { "id": "close_sprint", "method": "POST", "endpoint": "/:workspaceId/kanban/:boardId/sprints/:sprintId/close", "description": "스프린트 완료 및 미완료 태스크 이월" },
                  { "id": "get_board_analytics", "method": "GET", "endpoint": "/:workspaceId/kanban/:boardId/analytics", "description": "번다운 차트·속도·완료율 통계 조회" },
                  { "id": "ai_suggest_assignee", "method": "POST", "endpoint": "/:workspaceId/kanban/:boardId/tasks/:taskId/ai/suggest-assignee", "description": "AI 담당자 추천 (워크로드 기반)" }
                ],
                "links": ["/:workspaceId/kanban/:boardId/tasks/:taskId"],
                "children": [
                  {
                    "path": "/:workspaceId/kanban/:boardId/tasks/:taskId",
                    "pathparam": {
                      "workspaceId": "워크스페이스 식별자",
                      "boardId": "보드 ID",
                      "taskId": "태스크 고유 ID"
                    },
                    "description": "태스크 상세 — 담당자·마감일·우선순위·서브태스크·연결 문서·댓글",
                    "actions": [
                      { "id": "get_task", "method": "GET", "endpoint": "/:workspaceId/kanban/:boardId/tasks/:taskId", "description": "태스크 상세 조회" },
                      { "id": "update_task", "method": "PATCH", "endpoint": "/:workspaceId/kanban/:boardId/tasks/:taskId", "description": "태스크 수정 (제목·상태·담당자·마감일·우선순위)" },
                      { "id": "move_task", "method": "PATCH", "endpoint": "/:workspaceId/kanban/:boardId/tasks/:taskId/move", "description": "컬럼 간 태스크 이동" },
                      { "id": "delete_task", "method": "DELETE", "endpoint": "/:workspaceId/kanban/:boardId/tasks/:taskId", "description": "태스크 삭제" },
                      { "id": "add_subtask", "method": "POST", "endpoint": "/:workspaceId/kanban/:boardId/tasks/:taskId/subtasks", "description": "서브태스크 추가" },
                      { "id": "link_wiki", "method": "POST", "endpoint": "/:workspaceId/kanban/:boardId/tasks/:taskId/links", "description": "위키 문서·데이터 레코드 연결" },
                      { "id": "add_comment", "method": "POST", "endpoint": "/:workspaceId/kanban/:boardId/tasks/:taskId/comments", "description": "태스크 댓글 추가 (멘션·파일 첨부)" },
                      { "id": "log_time", "method": "POST", "endpoint": "/:workspaceId/kanban/:boardId/tasks/:taskId/timelogs", "description": "작업 시간 기록" },
                      { "id": "get_activity", "method": "GET", "endpoint": "/:workspaceId/kanban/:boardId/tasks/:taskId/activity", "description": "태스크 변경 이력 조회" }
                    ],
                    "links": ["/:workspaceId/wiki/:docId", "/:workspaceId/data/:tableId"],
                    "children": []
                  }
                ]
              }
            ]
          },

          {
            "path": "/:workspaceId/channel",
            "pathparam": {
              "workspaceId": "워크스페이스 식별자"
            },
            "description": "채널 — 실시간 메시지·화상회의·AI 에이전트. MS Teams·슬랙 대체",
            "actions": [
              { "id": "list_channels", "method": "GET", "endpoint": "/:workspaceId/channel", "description": "참여 채널 목록 조회 (공개·비공개·DM)" },
              { "id": "create_channel", "method": "POST", "endpoint": "/:workspaceId/channel", "description": "새 채널 생성" },
              { "id": "search_messages", "method": "GET", "endpoint": "/:workspaceId/channel/search?q=", "description": "전체 채널 메시지 통합 검색" }
            ],
            "links": ["/:workspaceId/channel/:channelId", "/:workspaceId/channel/dm/:userId", "/:workspaceId/channel/ai"],
            "children": [
              {
                "path": "/:workspaceId/channel/:channelId",
                "pathparam": {
                  "workspaceId": "워크스페이스 식별자",
                  "channelId": "채널 고유 ID"
                },
                "description": "채널 상세 — 메시지 스레드, 파일 공유, 회의, 멤버 관리",
                "actions": [
                  { "id": "get_messages", "method": "GET", "endpoint": "/:workspaceId/channel/:channelId/messages", "description": "메시지 목록 조회 (페이지네이션)" },
                  { "id": "send_message", "method": "POST", "endpoint": "/:workspaceId/channel/:channelId/messages", "description": "메시지 전송 (텍스트·파일·위키 인용·태스크 카드)" },
                  { "id": "edit_message", "method": "PATCH", "endpoint": "/:workspaceId/channel/:channelId/messages/:messageId", "description": "메시지 수정" },
                  { "id": "delete_message", "method": "DELETE", "endpoint": "/:workspaceId/channel/:channelId/messages/:messageId", "description": "메시지 삭제" },
                  { "id": "reply_thread", "method": "POST", "endpoint": "/:workspaceId/channel/:channelId/messages/:messageId/replies", "description": "스레드 답글 작성" },
                  { "id": "add_reaction", "method": "POST", "endpoint": "/:workspaceId/channel/:channelId/messages/:messageId/reactions", "description": "이모지 반응 추가" },
                  { "id": "pin_message", "method": "POST", "endpoint": "/:workspaceId/channel/:channelId/messages/:messageId/pin", "description": "메시지 고정" },
                  { "id": "start_meeting", "method": "POST", "endpoint": "/:workspaceId/channel/:channelId/meetings", "description": "화상회의 시작" },
                  { "id": "get_meeting_summary", "method": "GET", "endpoint": "/:workspaceId/channel/:channelId/meetings/:meetingId/summary", "description": "AI 회의 요약·액션 아이템 조회" },
                  { "id": "invite_members", "method": "POST", "endpoint": "/:workspaceId/channel/:channelId/members", "description": "채널 멤버 초대" },
                  { "id": "leave_channel", "method": "DELETE", "endpoint": "/:workspaceId/channel/:channelId/members/me", "description": "채널 나가기" },
                  { "id": "list_files", "method": "GET", "endpoint": "/:workspaceId/channel/:channelId/files", "description": "채널 공유 파일 목록" },
                  { "id": "create_task_from_message", "method": "POST", "endpoint": "/:workspaceId/channel/:channelId/messages/:messageId/to-task", "description": "메시지를 칸반 태스크로 전환" }
                ],
                "links": ["/:workspaceId/wiki/:docId", "/:workspaceId/kanban/:boardId/tasks/:taskId"],
                "children": []
              },
              {
                "path": "/:workspaceId/channel/dm/:userId",
                "pathparam": {
                  "workspaceId": "워크스페이스 식별자",
                  "userId": "상대방 사용자 ID"
                },
                "description": "다이렉트 메시지 — 1:1 또는 소그룹 프라이빗 대화",
                "actions": [
                  { "id": "get_dm_messages", "method": "GET", "endpoint": "/:workspaceId/channel/dm/:userId/messages", "description": "DM 메시지 목록 조회" },
                  { "id": "send_dm", "method": "POST", "endpoint": "/:workspaceId/channel/dm/:userId/messages", "description": "DM 전송" },
                  { "id": "create_group_dm", "method": "POST", "endpoint": "/:workspaceId/channel/dm/group", "description": "소그룹 DM 생성" }
                ],
                "links": [],
                "children": []
              },
              {
                "path": "/:workspaceId/channel/ai",
                "pathparam": {
                  "workspaceId": "워크스페이스 식별자"
                },
                "description": "AI 에이전트 — 프로젝트 전체 데이터 기반 의사결정 지원. 프레젠테이션 대체",
                "actions": [
                  { "id": "ask_ai", "method": "POST", "endpoint": "/:workspaceId/channel/ai/query", "description": "자연어 질문 → 위키·데이터·칸반 통합 분석 답변" },
                  { "id": "get_project_insight", "method": "POST", "endpoint": "/:workspaceId/channel/ai/insight", "description": "특정 프로젝트 진행 상황·리스크·병목 AI 분석" },
                  { "id": "get_member_workload", "method": "POST", "endpoint": "/:workspaceId/channel/ai/workload", "description": "팀원별 워크로드 분석 및 재배분 제안" },
                  { "id": "generate_report", "method": "POST", "endpoint": "/:workspaceId/channel/ai/report", "description": "데이터·태스크 기반 보고서 자동 생성 (위키에 저장)" },
                  { "id": "ask_data_question", "method": "POST", "endpoint": "/:workspaceId/channel/ai/data-query", "description": "자연어로 데이터 테이블 조회 — 비개발자 SQL 대체" },
                  { "id": "get_ai_history", "method": "GET", "endpoint": "/:workspaceId/channel/ai/history", "description": "AI 대화 이력 조회" },
                  { "id": "schedule_ai_report", "method": "POST", "endpoint": "/:workspaceId/channel/ai/schedule", "description": "정기 AI 보고서 채널 자동 발송 설정" }
                ],
                "links": ["/:workspaceId/data/:tableId", "/:workspaceId/wiki/:docId", "/:workspaceId/kanban/:boardId"],
                "children": []
              }
            ]
          },

          {
            "path": "/:workspaceId/data",
            "pathparam": {
              "workspaceId": "워크스페이스 식별자"
            },
            "description": "데이터 — 엑셀 대체. 폼·목록·시각화로 비개발자가 구조화 데이터 관리",
            "actions": [
              { "id": "list_tables", "method": "GET", "endpoint": "/:workspaceId/data", "description": "데이터 테이블 목록 조회" },
              { "id": "create_table", "method": "POST", "endpoint": "/:workspaceId/data", "description": "새 데이터 테이블 생성 (필드 스키마 정의)" },
              { "id": "import_table", "method": "POST", "endpoint": "/:workspaceId/data/import", "description": "CSV·Excel 파일 가져오기" }
            ],
            "links": ["/:workspaceId/data/:tableId"],
            "children": [
              {
                "path": "/:workspaceId/data/:tableId",
                "pathparam": {
                  "workspaceId": "워크스페이스 식별자",
                  "tableId": "데이터 테이블 고유 ID"
                },
                "description": "데이터 테이블 — 목록 뷰·폼·시각화 세 뷰로 구성",
                "actions": [
                  { "id": "get_table_schema", "method": "GET", "endpoint": "/:workspaceId/data/:tableId/schema", "description": "필드 스키마 조회 (타입·필수여부·옵션)" },
                  { "id": "update_schema", "method": "PATCH", "endpoint": "/:workspaceId/data/:tableId/schema", "description": "필드 추가·수정·삭제" },
                  { "id": "export_table", "method": "GET", "endpoint": "/:workspaceId/data/:tableId/export?format=csv|xlsx", "description": "테이블 CSV·Excel 내보내기" }
                ],
                "links": ["/:workspaceId/data/:tableId/list", "/:workspaceId/data/:tableId/form", "/:workspaceId/data/:tableId/chart"],
                "children": [
                  {
                    "path": "/:workspaceId/data/:tableId/list",
                    "pathparam": {
                      "workspaceId": "워크스페이스 식별자",
                      "tableId": "테이블 ID"
                    },
                    "description": "목록 뷰어 — 원본 데이터 조회·필터·정렬·인라인 편집",
                    "actions": [
                      { "id": "list_records", "method": "GET", "endpoint": "/:workspaceId/data/:tableId/records", "description": "레코드 목록 조회 (필터·정렬·페이지네이션)" },
                      { "id": "create_record", "method": "POST", "endpoint": "/:workspaceId/data/:tableId/records", "description": "레코드 직접 추가 (인라인)" },
