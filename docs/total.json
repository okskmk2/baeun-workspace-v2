{
  "frontendRouteHierarchy": [
    {
      "path": "/",
      "name": "PublicRoot",
      "component": "PublicLayout",
      "componentType": "layout",
      "description": "공개 영역 공통 레이아웃",
      "children": [
        {
          "path": "",
          "fullPath": "/",
          "component": "HomePage",
          "componentType": "page",
          "description": "랜딩 홈"
        },
        {
          "path": "store",
          "fullPath": "/store",
          "component": "StorePage",
          "componentType": "page",
          "description": "스토어/플랜 소개"
        },
        {
          "path": "not-found",
          "fullPath": "/not-found",
          "component": "NotFoundPage",
          "componentType": "page",
          "description": "404 안내"
        },
        {
          "path": "login",
          "fullPath": "/login",
          "component": "LoginPage",
          "componentType": "page",
          "description": "로그인"
        },
        {
          "path": "signup",
          "fullPath": "/signup",
          "component": "SigupPage",
          "componentType": "page",
          "description": "회원가입"
        },
        {
          "path": "settings",
          "fullPath": "/settings",
          "component": "SettingsLayout",
          "componentType": "layout",
          "description": "사용자 설정 레이아웃",
          "meta": {
            "requiresAuth": true
          },
          "children": [
            {
              "path": "",
              "fullPath": "/settings",
              "redirect": "/settings/profile",
              "description": "기본 진입 리다이렉트"
            },
            {
              "path": "profile",
              "fullPath": "/settings/profile",
              "component": "ProfilePage",
              "componentType": "page",
              "description": "프로필 설정"
            },
            {
              "path": "security",
              "fullPath": "/settings/security",
              "component": "SecurityPage",
              "componentType": "page",
              "description": "보안 설정"
            },
            {
              "path": "plan",
              "fullPath": "/settings/plan",
              "component": "PlanLicensePage",
              "componentType": "page",
              "description": "요금제/라이선스"
            },
            {
              "path": "billing",
              "fullPath": "/settings/billing",
              "component": "BillingPage",
              "componentType": "page",
              "description": "결제 정보 관리"
