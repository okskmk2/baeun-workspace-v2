            {
              "path": "market",
              "fullPath": "/workspace/:workspaceId/board/market",
              "component": "WorkspaceBoardMarketPage",
              "componentType": "page",
              "description": "마켓 보드"
            },
            {
              "path": "resource",
              "fullPath": "/workspace/:workspaceId/board/resource",
              "component": "WorkspaceBoardResourcePage",
              "componentType": "page",
              "description": "리소스 보드"
            },
            {
              "path": "qna",
              "fullPath": "/workspace/:workspaceId/board/qna",
              "component": "WorkspaceBoardQnaPage",
              "componentType": "page",
              "description": "묻고 답하기 보드"
            },
            {
              "path": "celebration",
              "fullPath": "/workspace/:workspaceId/board/celebration",
              "redirectTemplate": "/workspace/:workspaceId/board/events",
              "description": "레거시 경로 리다이렉트"
