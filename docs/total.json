              "fullPath": "/settings/workspaces",
              "component": "WorkspaceListPage",
              "componentType": "page",
              "description": "워크스페이스 목록"
            },
            {
              "path": "workspaces/:workspaceId",
              "fullPath": "/settings/workspaces/:workspaceId",
              "component": "WorkspaceDetailPage",
              "componentType": "page",
              "description": "워크스페이스 상세"
            }
          ]
        }
      ]
    },
    {
