            {
              "path": "people",
              "fullPath": "/workspace/:workspaceId/board/people",
              "redirectTemplate": "/workspace/:workspaceId/board/resource",
              "description": "레거시 경로 리다이렉트"
            }
          ]
        },
        {
          "path": "rank",
          "fullPath": "/workspace/:workspaceId/rank",
          "name": "workspace-rank",
          "component": "WorkspaceRankPage",
          "componentType": "page",
          "description": "워크스페이스 랭킹"
        },
        {
          "path": "settings",
          "fullPath": "/workspace/:workspaceId/settings",
          "component": "WorkspaceSettingsLayout",
          "componentType": "layout",
          "description": "워크스페이스 설정 레이아웃",
          "children": [
            {
              "path": "",
              "fullPath": "/workspace/:workspaceId/settings",
