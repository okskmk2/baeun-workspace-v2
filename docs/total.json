              "component": "WorkspaceSettingsPage",
              "componentType": "page",
              "description": "일반 설정"
            },
            {
              "path": "members",
              "fullPath": "/workspace/:workspaceId/settings/members",
              "component": "WorkspaceSettingsMembersPage",
              "componentType": "page",
              "description": "멤버 관리"
            },
            {
              "path": "license",
              "fullPath": "/workspace/:workspaceId/settings/license",
              "component": "WorkspaceSettingsLicensePage",
              "componentType": "page",
              "description": "라이선스 설정"
