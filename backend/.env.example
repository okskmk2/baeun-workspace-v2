PORT=8080
CORS_ORIGIN=http://localhost:8081
SWAGGER_SERVER_URL=http://localhost:8080
SESSION_SECRET=change-me
SESSION_TTL_MS=86400000
# Public frontend origin used for Polar success/return URLs.
# Local: http://localhost:8081
# Production (Cloud Run): set this to https://workspace.baeun.com — NODE_ENV is not always production there.
APP_PUBLIC_URL=http://localhost:8081
# Passkeys work on http://localhost (a valid WebAuthn RP ID). Do not test on http://127.0.0.1.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:8081
# WEBAUTHN_RP_NAME=바은 워크스페이스
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENVIRONMENT=sandbox
